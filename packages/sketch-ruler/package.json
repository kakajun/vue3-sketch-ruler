{
  "name": "vue3-sketch-ruler",
  "version": "3.1.4",
  "private": false,
  "keywords": [
    "panzoom",
    "room",
    "ruler",
    "sketch",
    "sketch-ruler",
    "vue",
    "vue-sketch-ruler",
    "vue3"
  ],
  "bugs": {
    "url": "https://github.com/kakajun/vue3-sketch-ruler/issues"
  },
  "license": "MIT",
  "author": "kakajun <253495832@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakajun/vue3-sketch-ruler.git"
  },
  "style": "lib/style.css",
  "bin": {
    "vue3-sketch-ruler-migrate": "./bin/migrate.js"
  },
  "files": [
    "lib",
    "bin",
    "src",
    "AGENTS.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./style.css": "./lib/style.css",
    "./lib/style.css": "./lib/style.css",
    "./engine": {
      "development": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./composables": {
      "development": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./renderers": {
      "development": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./plugins": {
      "development": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "release": "release-it"
  },
  "dependencies": {
    "@sketch-ruler/canvas": "workspace:*",
    "@sketch-ruler/core": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.10",
    "vitest": "^4.1.6"
  }
}
